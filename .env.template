# IBM Consulting AI (ICA) API Configuration
# Copy this file to .env and fill in your credentials

# ICA nextgen-beta API base URL
ICA_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1

# Your ICA API key (Bearer token)
ICA_API_KEY=your_ica_api_key_here

# Model to use
ICA_MODEL=claude-sonnet-4-5

# Max output tokens (Claude Sonnet 4.5 supports up to 8192)
ICA_MAX_TOKENS=8192

# Temperature (0.0 = deterministic/precise, 1.0 = creative)
ICA_TEMPERATURE=0.3

# Optional: proxy settings (leave blank if not needed)
HTTPS_PROXY=
HTTP_PROXY=

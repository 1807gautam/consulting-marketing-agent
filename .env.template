# IBM Consulting AI (ICA) API Configuration
# Copy this file to .env and fill in your credentials

# ICA nextgen-beta API base URL
ICA_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1

# Your ICA Codex API key (Bearer token)
ICA_API_KEY=your_ica_api_key_here

# Model to use
# gpt-5.5-gus  — best for complex marketing analysis (recommended)
# gpt-4o       — faster, slightly simpler outputs
# NOTE: Claude/Bedrock models (claude-sonnet-*) do NOT work with Codex keys
ICA_MODEL=gpt-5.5-gus

# Max output tokens
ICA_MAX_TOKENS=8192

# Temperature — MUST be 1.0 for ICA Codex models (0.3 returns a 400 error)
ICA_TEMPERATURE=1.0

# Optional: proxy settings (leave blank if not needed)
HTTPS_PROXY=
HTTP_PROXY=
